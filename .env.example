# JWT
JWT_SECRET=movie-system-super-secret-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET_VIDEOS=movies-videos
MINIO_BUCKET_POSTERS=movies-posters

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Redis
REDIS_URL=redis://redis:6379

# MailHog
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=noreply@moviesystem.local

# LibreTranslate
LIBRETRANSLATE_URL=http://libretranslate:5000

# Service URLs (internal)
AUTH_SERVICE_URL=http://auth-service:8001
CATALOG_SERVICE_URL=http://catalog-service:8002
STORAGE_SERVICE_URL=http://storage-service:8003
SUBTITLE_SERVICE_URL=http://subtitle-service:8004
AI_SERVICE_URL=http://ai-service:8005
SUBSCRIPTION_SERVICE_URL=http://subscription-service:8006
NOTIFICATION_SERVICE_URL=http://notification-service:8007
