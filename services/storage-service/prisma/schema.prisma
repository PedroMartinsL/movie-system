generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FileRecord {
  id         String   @id @default(uuid())
  movieId    String
  type       FileType
  bucketName String
  objectName String
  size       BigInt
  mimeType   String
  createdAt  DateTime @default(now())

  @@unique([movieId, type])
}

enum FileType {
  VIDEO
  POSTER
}
