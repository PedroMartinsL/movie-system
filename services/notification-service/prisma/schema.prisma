generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model NotificationLog {
  id        String   @id @default(uuid())
  event     String
  payload   String
  recipient String?
  status    String   @default("SENT")
  createdAt DateTime @default(now())
}
